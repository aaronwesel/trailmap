# CODEOWNERS — map monorepo paths to GitHub team labels / handles.
#
# Prep note: replace @trailmap/... placeholders with real GitHub teams once
# org teams exist. Until then, these labels document intended ownership for
# review routing (see docs/workstreams.md and CONTRIBUTING.md).
#
# Pattern: last matching pattern wins. Keep path → stream mapping stable so
# PR review requests stay predictable during the production rollout.

# Default catch-all — platform / lead
*                              @trailmap/platform-leads

# Backend / API stream
/backend/                      @trailmap/api-team
/backend/app/api/              @trailmap/api-team
/backend/app/models/           @trailmap/api-team
/backend/alembic/              @trailmap/api-team

# Frontend / UI stream
/frontend/                     @trailmap/ui-team

# Infra / Terraform / Compose ops
/infra/                        @trailmap/infra-team
/docker-compose.yml            @trailmap/infra-team
/.github/workflows/            @trailmap/infra-team

# Mobile apps
/apps/                         @trailmap/mobile-team
/apps/android/                 @trailmap/mobile-team
/apps/ios/                     @trailmap/mobile-team

# AI clients / feature flags (DeepSeek, Rekognition stubs)
/backend/app/clients/deepseek.py      @trailmap/ai-team
/backend/app/clients/rekognition.py   @trailmap/ai-team

# Docs + contributor workflow (shared)
/docs/                         @trailmap/platform-leads
/CONTRIBUTING.md               @trailmap/platform-leads
/.github/CODEOWNERS            @trailmap/platform-leads
