{
  "ConnectionStrings": {
    "Crawl": "Host=localhost;Port=5432;Database=crawl;Username=app;Password=changeme-local-only"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "PageQueue": "crawl.page",
    "PageDlq": "crawl.page.dlq",
    "PrefetchCount": 8,
    "MaxRetryAttempts": 3,
    "EnableDepthPriority": true,
    "MaxDepthPriority": 10
  },
  "CrawlHttp": {
    "TimeoutSeconds": 15,
    "MaxRetryAttempts": 3,
    "MaxResponseBytes": 2000000,
    "MaxConcurrentFetches": 4,
    "PolitenessDelayMilliseconds": 250,
    "MaxPolitenessMultiplier": 16,
    "RespectRobotsTxt": true,
    "UserAgentToken": "TrailmapCrawlBot",
    "UserAgent": "TrailmapCrawlBot/1.0 (+https://github.com/aaronwesel/trailmap)",
    "MaxRedirects": 5,
    "SortQueryParameters": true
  },
  "CrawlAi": {
    "Enabled": true,
    "IncidentMonitorEnabled": true,
    "DeepSeekApiKey": "",
    "DeepSeekBaseUrl": "https://api.deepseek.com",
    "DeepSeekModel": "deepseek-chat"
  },
  "Crawl": {
    "Alerts": {
      "EmailEnabled": false,
      "Provider": "stub",
      "FromAddress": "",
      "ToAddress": ""
    }
  },
  "CrawlEgress": {
    "Enabled": false,
    "Proxies": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
