# Copy to .env for local Compose. Do not put real secrets in git.
# Production: use AWS Secrets Manager / SSM — never bake secrets into images.

# --- Compose / local ---
COMPOSE_PROJECT_NAME=trailmap

# --- Postgres (local Compose only) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme-local-only
POSTGRES_DB=app
DATABASE_URL=postgresql+psycopg://app:changeme-local-only@db:5432/app
# Crawl EF Core — Compose default shares `app` DB (crawl_* tables). Optional: Database=crawl (init script).
CRAWL_DATABASE_URL=Host=127.0.0.1;Port=5432;Database=app;Username=app;Password=changeme-local-only

# --- Redis (local Compose only) ---
REDIS_URL=redis://redis:6379/0

# --- RabbitMQ (local stand-in for Amazon MQ) ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_UI_PORT=15672
CRAWL_QUEUE=crawl.page
CRAWL_DLQ=crawl.page.dlq

# --- Crawl.Api / Crawl.Worker ---
CRAWL_API_PORT=8080
CRAWL_WORKER_PORT=8081
CRAWL_HTTP_TIMEOUT_SECONDS=15
CRAWL_MAX_CONCURRENT_FETCHES=4
CRAWL_POLITENESS_DELAY_MS=250
CRAWL_RESPECT_ROBOTS=true
CRAWL_MAX_REDIRECTS=5
CRAWL_SORT_QUERY=true
CRAWL_DEPTH_PRIORITY=true
ASPNETCORE_ENVIRONMENT=Development
# Optional: http://otel-collector:4317 with `docker compose --profile otel up`
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Platform API ---
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=local
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Generate a strong value locally; never commit the real secret
JWT_SECRET=replace-with-local-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Optional Fernet key for MFA secrets at rest (else derived from JWT_SECRET locally)
FIELD_ENCRYPTION_KEY=
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
MFA_ISSUER=Trailmap

# --- Frontend ---
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000
# Vite + `dotnet run` → :5059; Compose frontend image → host-mapped :8080
VITE_CRAWL_API_URL=http://localhost:5059
VITE_GOOGLE_CLIENT_ID=
VITE_MICROSOFT_CLIENT_ID=
VITE_MICROSOFT_TENANT_ID=common

# --- OAuth / One Tap (also accepts GOOGLE_OAUTH_* / MICROSOFT_OAUTH_*) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# --- AI (off by default for DeepSeek; CrawlAi flags default on with heuristic fallback) ---
DEEPSEEK_API_KEY=
DEEPSEEK_ENABLED=false
CRAWL_AI_ENABLED=true
# Crawl.Ai feature flags (also via appsettings CrawlAi section)
# CrawlAi__Enabled=true
# CrawlAi__FieldFinderEnabled=true
# CrawlAi__LoginAssistEnabled=true
# CrawlAi__SummarizationEnabled=true
# CrawlAi__AskTheCrawlEnabled=true
# CrawlAi__AgentLoopEnabled=true
# CrawlAi__IncidentMonitorEnabled=true
# Stretch incident email alerts (off by default; never put passwords in bodies)
CRAWL_ALERTS_EMAIL_ENABLED=false
CRAWL_ALERT_TO_EMAIL=
# Optional egress proxy pool for hard-block remediations (fail closed when empty)
# CrawlEgress__Enabled=true
# CrawlEgress__Proxies__0=http://127.0.0.1:8888
AWS_REGION=
# Rekognition uses task role in AWS; local optional
REKOGNITION_ENABLED=false

# --- Amazon SES alerts (off by default; no PHI in email bodies) ---
SES_FROM_EMAIL=
SES_REGION=
SES_ENABLED=false
# Crawl job subscriber alerts (guided step 5): set EmailEnabled + Provider=ses|stub and FromAddress
CRAWL_ALERTS_EMAIL_ENABLED=false
LOGIN_ALERT_EMAIL_ENABLED=false
LOGIN_ALERT_TO_EMAIL=

# --- Slack Incoming Webhook (off by default; never put PHI in Slack messages) ---
SLACK_WEBHOOK_URL=
SLACK_ENABLED=false

# --- Stripe Billing (test mode; never commit real secrets) ---
# Prefer restricted API keys (rk_test_...) over sk_test_ when possible.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_METERED_PRICE_ID=
STRIPE_METER_EVENT_NAME=crawl_pages_with_results
CRAWL_FREE_PAGES=5000
CRAWL_PRICE_PER_PAGE_CENTS=2
CRAWL_PRICE_CURRENCY=usd
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/billing?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/billing?checkout=cancel
STRIPE_PORTAL_RETURN_URL=http://localhost:5173/billing
# Optional client hint (publishable key is safe in the browser)
VITE_STRIPE_PUBLISHABLE_KEY=

# --- Platform ops (audit / break-glass / media / webhooks) ---
BREAK_GLASS_DEFAULT_TTL_MINUTES=60
BREAK_GLASS_MAX_TTL_MINUTES=1440
MEDIA_SIGNING_SECRET=
MEDIA_PUBLIC_BASE_URL=https://media.example.local/objects
MEDIA_SIGNED_URL_TTL_SECONDS=300
MEDIA_SIGNED_URL_MAX_TTL_SECONDS=3600
WEBHOOKS_ENABLED=true
WEBHOOK_SIGNING_SECRET=
WEBHOOK_MAX_ATTEMPTS=8
