# Copy to environments/prod.tfvars (do not commit real secrets).
# terraform apply is FORBIDDEN before production apply is authorized.

project_name = "trailmap"
environment  = "prod"
aws_region   = "eu-west-1"

vpc_cidr           = "10.30.0.0/16"
availability_zones = ["eu-west-1a", "eu-west-1b", "eu-west-1c"]

# REQUIRED before prod apply
acm_certificate_arn = "arn:aws:acm:eu-west-1:CHANGE_ME:certificate/CHANGE_ME"

api_image_tag    = "stable"
worker_image_tag = "stable"

api_cpu              = 1024
api_memory           = 2048
api_desired_count    = 2
api_min_capacity     = 2
api_max_capacity     = 10
worker_cpu           = 1024
worker_memory        = 2048
worker_desired_count = 2
worker_min_capacity  = 2
worker_max_capacity  = 8

# ALB RequestCountPerTarget target (tune in production)
api_requests_per_target = 800

db_engine_version = "15.4"
db_instance_class = "db.r6g.large"
db_name           = "trailmap"

redis_node_type = "cache.r6g.large"

log_retention_days = 90
enable_waf         = true
enable_nat_gateway = true

# SES placeholders (verify identity in production; DO NOT apply yet)
enable_ses      = true
ses_domain_name = ""
ses_from_email  = ""

tags = {
  CostCenter = "trailmap-prod"
  Criticality = "high"
}
