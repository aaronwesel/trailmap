# Application
APP_NAME=trailmap-api
ENVIRONMENT=local
DEBUG=false
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SECRET_KEY=change-me-in-secrets-manager
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Fernet key for MFA TOTP secrets at rest (optional locally — derived from SECRET_KEY)
FIELD_ENCRYPTION_KEY=
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900
MFA_ISSUER=Trailmap

# Database (Aurora/RDS Postgres in AWS; local Compose Postgres)
DATABASE_URL=postgresql+psycopg://app:changeme-local-only@localhost:5432/app

# Redis (ElastiCache in AWS; local Compose Redis)
REDIS_URL=redis://localhost:6379/0

# Optional Redis rate limit (shared across API tasks; stickiness OFF)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Google Identity Services (One Tap)
# Also accepted: GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra / MSAL (One Tap)
# Also accepted: MICROSOFT_OAUTH_CLIENT_ID / SECRET / TENANT_ID
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# DeepSeek (feature flag OFF by default; never put PHI in prompts)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_ENABLED=false

# AWS / Rekognition (prefer task-role IAM in ECS; keys optional for local)
# Set to your AWS region (do not commit real credentials)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REKOGNITION_ENABLED=false

# Amazon SES alerts (OFF by default; never put PHI in email bodies)
SES_FROM_EMAIL=
SES_REGION=
SES_ENABLED=false
LOGIN_ALERT_EMAIL_ENABLED=false
LOGIN_ALERT_TO_EMAIL=

# Slack Incoming Webhook (OFF by default; never put PHI in Slack messages)
# Store the real URL in AWS Secrets Manager in non-local envs — see infra secrets module.
SLACK_WEBHOOK_URL=
SLACK_ENABLED=false

# Stripe Billing — test mode only in local development. Prefer a restricted API key (rk_test_...).
# Never commit real secrets; use Secrets Manager / SSM in AWS.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/billing?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/billing?checkout=cancel
STRIPE_PORTAL_RETURN_URL=http://localhost:5173/billing
# Crawl metered billing (test): 5000 free pages-with-results, then per-page rate on Stripe Billing Meter
STRIPE_METERED_PRICE_ID=
STRIPE_METER_EVENT_NAME=crawl_pages_with_results
CRAWL_FREE_PAGES=5000
CRAWL_PRICE_PER_PAGE_CENTS=2
CRAWL_PRICE_CURRENCY=usd

# Break-glass emergency access (time-boxed; mandatory reason_code; SES/Slack hooks)
BREAK_GLASS_DEFAULT_TTL_MINUTES=60
BREAK_GLASS_MAX_TTL_MINUTES=1440

# Signed media URLs (S3-minded stub; prefer dedicated signing secret in prod)
MEDIA_SIGNING_SECRET=
MEDIA_PUBLIC_BASE_URL=https://media.example.local/objects
MEDIA_SIGNED_URL_TTL_SECONDS=300
MEDIA_SIGNED_URL_MAX_TTL_SECONDS=3600

# Webhook outbox (HMAC-signed outbound deliveries; payloads must stay PHI-free)
WEBHOOKS_ENABLED=true
WEBHOOK_SIGNING_SECRET=
WEBHOOK_MAX_ATTEMPTS=8
